#usda 1.0
(
    defaultPrim = "Sunray150WithMid360Cargo"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Sunray150WithMid360Cargo" (
    prepend references = @./_deps/sunray150_with_mid360_v2/sunray150_with_mid360_v2.usda@</Sunray150WithMid360V2>
    apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    kind = "component"
)
{
    def Xform "mounted_cargo_bay" (
        prepend references = @./air_fpv_box.usd@
    )
    {
        double3 xformOp:translate = (0, 0, -0.2595)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsFixedJoint "cargo_mount_joint"
    {
        rel physics:body0 = </Sunray150WithMid360Cargo/body>
        rel physics:body1 = </Sunray150WithMid360Cargo/mounted_cargo_bay/transparent_cargo_bay/cargo_body>
        bool physics:collisionEnabled = 0
        uniform bool physics:excludeFromArticulation = 1
        bool physics:jointEnabled = 1
        point3f physics:localPos0 = (0, 0, -0.2595)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}

                }
                def Cube "right_panel_y_negative" (prepend apiSchemas = ["PhysicsCollisionAPI"])
                {
                    double size = 1
                    bool physics:collisionEnabled = true
                    rel material:binding = </World/transparent_cargo_bay/Looks/transparent_blue>
                    color3f[] primvars:displayColor = [(0.4, 0.8, 1.0)]
                    float[] primvars:displayOpacity = [0.3]
                    double3 xformOp:translate = (0, -0.069, 0.03)
                    double3 xformOp:scale = (0.2, 0.002, 0.054)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
            def Cylinder "visual_left_door_hinge_barrel"
            {
                uniform token axis = "X"
                double radius = 0.002
                double height = 0.19
                rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                double3 xformOp:translate = (0, 0.071, 0.06)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
            def Cylinder "visual_bottom_door_hinge_barrel"
            {
                uniform token axis = "X"
                double radius = 0.002
                double height = 0.19
                rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                double3 xformOp:translate = (0, -0.071, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def Xform "left_door" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            bool physics:rigidBodyEnabled = true
            bool physics:kinematicEnabled = false
            float physics:mass = 0.045
            vector3f physics:diagonalInertia = (0.000011, 0.00004, 0.00004)
            double3 xformOp:translate = (0, 0.07, 0.06)
            double3 xformOp:rotateXYZ = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            def Cube "transparent_panel_collision" (prepend apiSchemas = ["PhysicsCollisionAPI"])
            {
                double size = 1
                rel material:binding = </World/transparent_cargo_bay/Looks/transparent_blue>
                color3f[] primvars:displayColor = [(0.4, 0.8, 1.0)]
                float[] primvars:displayOpacity = [0.3]
                double3 xformOp:translate = (0, 0, -0.027)
                double3 xformOp:scale = (0.2, 0.002, 0.054)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "handle" (prepend apiSchemas = ["PhysicsCollisionAPI"])
            {
                double size = 1
                rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                double3 xformOp:translate = (0.032, 0.0015, -0.04)
                double3 xformOp:scale = (0.018, 0.004, 0.004)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cylinder "visual_hinge_pin"

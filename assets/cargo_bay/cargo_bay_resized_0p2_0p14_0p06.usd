                    double3 xformOp:translate = (0, 0.0685, 0.0015)
                    double3 xformOp:scale = (0.2, 0.003, 0.003)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
                def Cube "x_edge_bottom_rightY" (prepend apiSchemas = ["PhysicsCollisionAPI"])
                {
                    double size = 1
                    rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>

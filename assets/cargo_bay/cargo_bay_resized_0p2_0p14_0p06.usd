            point3f physics:centerOfMass = (0, 0, 0)
            quatf physics:principalAxes = (1, 0, 0, 0)
            def Xform "frame"
            {
                def Cube "x_edge_bottom_leftY" (prepend apiSchemas = ["PhysicsCollisionAPI"])
                {
                    double size = 1

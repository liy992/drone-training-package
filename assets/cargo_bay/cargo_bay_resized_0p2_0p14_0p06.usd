#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    framesPerSecond = 60
    timeCodesPerSecond = 60
)

def Xform "World"
{
    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "transparent_cargo_bay"
    {
        def Scope "Looks"
        {
            def Material "transparent_blue"
            {
                token outputs:surface.connect = </World/transparent_cargo_bay/Looks/transparent_blue/PreviewSurface.outputs:surface>
                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.4, 0.8, 1.0)
                    float inputs:opacity = 0.3
                    float inputs:roughness = 0.15
                    float inputs:metallic = 0
                    int inputs:useSpecularWorkflow = 0
                    token outputs:surface
                }
            }
            def Material "dark_frame"
            {
                token outputs:surface.connect = </World/transparent_cargo_bay/Looks/dark_frame/PreviewSurface.outputs:surface>
                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.02, 0.025, 0.03)
                    float inputs:opacity = 1.0
                    float inputs:roughness = 0.45
                    float inputs:metallic = 0
                    int inputs:useSpecularWorkflow = 0
                    token outputs:surface
                }
            }
        }

        def Xform "cargo_body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {

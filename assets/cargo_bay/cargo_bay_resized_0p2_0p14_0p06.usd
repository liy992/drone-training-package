                {
                    double size = 1
                    rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                    double3 xformOp:translate = (0.0985, 0.0685, 0.03)
                    double3 xformOp:scale = (0.003, 0.003, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
                def Cube "z_edge_frontX_rightY" (prepend apiSchemas = ["PhysicsCollisionAPI"])
                {
                    double size = 1
                    rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                    double3 xformOp:translate = (0.0985, -0.0685, 0.03)

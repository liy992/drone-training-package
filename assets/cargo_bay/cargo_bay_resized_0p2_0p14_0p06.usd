                double3 xformOp:translate = (0, 0.07, 0)
                double3 xformOp:scale = (0.2, 0.14, 0.002)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cube "handle_or_limit_block" (prepend apiSchemas = ["PhysicsCollisionAPI"])
            {
                double size = 1

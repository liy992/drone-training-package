    def Camera "Camera"
    {
        double3 xformOp:translate = (0.17, -0.145, 0.105)
        double3 xformOp:rotateXYZ = (60, 0, 47)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        float focalLength = 45
        float focusDistance = 0.2
        float2 clippingRange = (0.001, 10)
    }
    def DistantLight "Sun_Key_Light"
    {
        float intensity = 650
        double3 xformOp:rotateXYZ = (-45, 0, 35)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
    def DomeLight "Soft_Fill_Light"
    {
        float intensity = 120
    }

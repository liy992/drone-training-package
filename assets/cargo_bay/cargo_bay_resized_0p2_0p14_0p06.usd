                double3 xformOp:translate = (0.03, 0.133, -0.003)
                double3 xformOp:scale = (0.02, 0.004, 0.004)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }
            def Cylinder "visual_hinge_pin"
            {
                uniform token axis = "X"
                double radius = 0.0014
                double height = 0.19
                rel material:binding = </World/transparent_cargo_bay/Looks/dark_frame>
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }

        def Scope "joints"
        {
            def PhysicsRevoluteJoint "left_door_hinge_joint" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
            {
                rel physics:body0 = </World/transparent_cargo_bay/cargo_body>
                rel physics:body1 = </World/transparent_cargo_bay/left_door>
                uniform token physics:axis = "X"
                float physics:lowerLimit = 0
                float physics:upperLimit = 90
                point3f physics:localPos0 = (0, 0.07, 0.06)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                token drive:angular:physics:type = "force"
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                float drive:angular:physics:stiffness = 1.5
                float drive:angular:physics:damping = 0.1
                float drive:angular:physics:maxForce = 5
            }
            def PhysicsRevoluteJoint "bottom_door_hinge_joint" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
            {
                rel physics:body0 = </World/transparent_cargo_bay/cargo_body>
                rel physics:body1 = </World/transparent_cargo_bay/bottom_door>
                uniform token physics:axis = "X"
                float physics:lowerLimit = -90
                float physics:upperLimit = 0
                point3f physics:localPos0 = (0, -0.07, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                token drive:angular:physics:type = "force"
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                float drive:angular:physics:stiffness = 1.5
                float drive:angular:physics:damping = 0.1
                float drive:angular:physics:maxForce = 5
            }

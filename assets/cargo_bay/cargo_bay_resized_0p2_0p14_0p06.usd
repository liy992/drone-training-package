            }
            def Xform "fixed_transparent_panels"
            {
                def Cube "top_panel" (prepend apiSchemas = ["PhysicsCollisionAPI"])
                {
                    double size = 1
                    bool physics:collisionEnabled = true
                    rel material:binding = </World/transparent_cargo_bay/Looks/transparent_blue>
                    color3f[] primvars:displayColor = [(0.4, 0.8, 1.0)]
                    float[] primvars:displayOpacity = [0.3]
                    double3 xformOp:translate = (0, 0, 0.059)
